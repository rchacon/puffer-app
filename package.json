{
  "name": "puffer-power",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @puffer-power/game",
    "build": "npm run build -w @puffer-power/game",
    "preview": "npm run preview -w @puffer-power/game",
    "test": "npm test --workspaces --if-present",
    "test:watch": "npm run test:watch -w @puffer-power/game",
    "audio:gen": "npm run audio:gen -w @puffer-power/game",
    "screenshot": "npm run screenshot -w @puffer-power/game"
  }
}
